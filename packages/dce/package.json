{
  "name": "@nfewizard/dce",
  "version": "1.0.2",
  "description": "Biblioteca Node.js para DCe - Declaracao de Conteudo eletronica",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/src/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dce",
    "declaracao de conteudo",
    "sefaz",
    "dfe"
  ],
  "author": "maurelima",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nfewizard-org/nfewizard-io",
    "directory": "packages/dce"
  },
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@nfewizard/shared": "workspace:*",
    "@nfewizard/types": "workspace:*",
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.59.0",
    "typescript": "^5.4.5"
  }
}
